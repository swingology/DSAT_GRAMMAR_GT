# Database
DATABASE_URL=postgresql+asyncpg://dsat:dsat@localhost:5432/dsat

# Auth
ADMIN_API_KEYS=admin-key-change-me
STUDENT_API_KEYS=student-key-change-me

# LLM
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MAX_CONCURRENT=8

# Storage
RAW_ASSET_STORAGE_BACKEND=local
LOCAL_ARCHIVE_MIRROR=./archive

# LLM defaults
DEFAULT_ANNOTATION_PROVIDER=ollama
DEFAULT_ANNOTATION_MODEL=deepseek-v4-pro:cloud
DEFAULT_OLLAMA_MODEL=deepseek-v4-pro:cloud
RULES_VERSION=rules_agent_dsat_grammar_ingestion_generation_v3

# OCR / Vision
OCR_VISION_PROVIDER=ollama
OCR_VISION_MODEL=qwen3.0-vl
OCR_STRATEGY=glm
GLM_OCR_MODEL=glm-ocr:latest
OCR_FALLBACK=true
OCR_PAGE_CONCURRENCY=3
VISION_MAX_IMAGES=10

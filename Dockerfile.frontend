FROM node:20-bookworm-slim

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies. `cache clean --force` first: a corrupted local npm
# cache was once silently reused across builds here (podman build cache did
# not honor --no-cache for it), producing broken packages that still passed
# npm's integrity check. Forcing a clean cache avoids relying on it.
RUN npm cache clean --force && npm ci --legacy-peer-deps --no-audit --no-fund

# Copy frontend code
COPY . ./

# Expose port
EXPOSE 5173

# Health check
HEALTHCHECK --interval=5s --timeout=5s --retries=10 \
    CMD node -e "fetch('http://localhost:5173/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# Run Vite dev server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

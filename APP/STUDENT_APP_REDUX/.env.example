VITE_API_BASE=/api
BACKEND_PROXY_URL=http://127.0.0.1:8000
VITE_STUDENT_API_KEY=student-test-key

# Google OAuth client ID (public — not a secret; the client secret is used nowhere).
# Must match `google_oauth_client_id` in backend/app/config.py.
VITE_GOOGLE_CLIENT_ID=721127096332-4b5fgqs0dfn8g414gnehrnbrb85q22r4.apps.googleusercontent.com

# Legacy pre-OAuth identity. When set, it overrides the signed-in user's token — leave
# it empty for normal Google sign-in. Kept so scripts and tests keep working.
VITE_TEST_USER_TOKEN=
